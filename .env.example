# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SMTP settings for live outbound 24-hour club event reminder emails.
# When omitted, reminders are queued and delivered through the hub's institutional notification outbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CUNY SPS Club Social Hub <studentlife-noreply@sps.cuny.edu>"

# Admin Edit Mode password (optional — if left blank, use the in-app Admin button to set one on first run).
SITE_EDITOR_ADMIN_PASSWORD=

# Authentication & Onboarding settings
# Set DEMO_MODE=false to hide the Demo sign-in persona picker completely in production.
DEMO_MODE=true

# Paste your Google OAuth 2.0 Web Client ID here to enable real Google Sign-In for @spsmail.cuny.edu and @sps.cuny.edu accounts.
GOOGLE_CLIENT_ID=

# Optional comma-separated list of additional @sps.cuny.edu staff emails granted Student Life Admin access.
STUDENT_LIFE_ADMIN_EMAILS=


